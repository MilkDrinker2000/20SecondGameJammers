//wobble_duration signifies how long the wobble lasts, currently set for 3 seconds
//the wobble_strength is exactly how it souunds
//wobble time is essentially the countdown variable for the wobble
//wobble_true is a progress tracker for the wobble
//wobble_gain is a variable that adds more wobble


wobble_duration = 150;
wobble_strength_y = 50;
wobble_strength_x = 20
wobble_time = 0;
wobble_true = 0;
wobble_gain = 1;


//This hides the cursor
window_set_cursor(cr_none);